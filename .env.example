DATABASE_URL=postgresql://mission:mission@localhost:5432/mission?schema=public
API_PORT=3001
API_HOST=0.0.0.0
# Empty = same-origin /api via Nuxt proxy
NUXT_PUBLIC_API_BASE=
NUXT_API_PROXY_TARGET=http://127.0.0.1:3001/api
MASTER_DATA_DIR=../../master
MISSIONS_DIR=../../missions

# LLM — MiniMax (OpenAI-compatible Chat Completions)
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
# Mainland China (常见 sk-cp-*): https://api.minimaxi.com/v1
# International: https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.5

# Optional OpenAI fallback (set LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
